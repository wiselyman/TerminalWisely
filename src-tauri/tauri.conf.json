{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerminalWisely",
  "version": "1.0.1",
  "identifier": "com.wangyunfei.terminalwisely",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TerminalWisely",
        "width": 1400,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agent-sidecar/app": "agent-sidecar/app",
      "../agent-sidecar/policy": "agent-sidecar/policy",
      "../agent-sidecar/runtime": "agent-sidecar/runtime",
      "../agent-sidecar/requirements.txt": "agent-sidecar/requirements.txt",
      "../agent-sidecar/requirements-runtime.txt": "agent-sidecar/requirements-runtime.txt",
      "../agent-sidecar/README.md": "agent-sidecar/README.md"
    }
  }
}
